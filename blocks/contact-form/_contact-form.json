{
  "definitions": [
    {
      "title": "Contact Form",
      "id": "contact-form",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Contact Form",
              "model": "contact-form",
              "filter": "contact-form",
              "submit_profile": "life-advisor"
            }
          }
        }
      }
    },
    {
      "title": "Contact Form Field",
      "id": "contact-form-field",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Contact Form Field",
              "model": "contact-form-field",
              "type": "text",
              "type_settings": ["required"]
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "contact-form",
      "fields": [
        {
          "component": "richtext",
          "valueType": "string",
          "name": "text",
          "label": "Heading and note",
          "description": "Form heading followed by a short note, for example: *All fields mandatory",
          "value": ""
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "submit",
          "label": "Button label",
          "description": "Required. For example: Get Advisor Support",
          "value": ""
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "submit_profile",
          "label": "Form type",
          "description": "Selects the submission settings for this form. Contact cards open the form with a link to #form-type, for example #life-advisor",
          "value": "life-advisor",
          "options": [
            {
              "name": "Life advisor request",
              "value": "life-advisor"
            },
            {
              "name": "Callback request",
              "value": "callback"
            },
            {
              "name": "General enquiry",
              "value": "enquiry"
            }
          ]
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "success",
          "label": "Success message",
          "description": "Shown after the details have been sent",
          "value": ""
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "failure",
          "label": "Error message",
          "description": "Shown when the details could not be sent",
          "value": ""
        }
      ]
    },
    {
      "id": "contact-form-field",
      "fields": [
        {
          "component": "select",
          "valueType": "string",
          "name": "type",
          "label": "Field type",
          "value": "text",
          "options": [
            {
              "name": "Text",
              "value": "text"
            },
            {
              "name": "Email",
              "value": "email"
            },
            {
              "name": "Mobile number",
              "value": "tel"
            },
            {
              "name": "Pincode",
              "value": "pincode"
            },
            {
              "name": "Message (multi-line text)",
              "value": "textarea"
            },
            {
              "name": "Dropdown",
              "value": "select"
            },
            {
              "name": "Radio buttons",
              "value": "radio"
            },
            {
              "name": "Checkboxes",
              "value": "checkbox"
            },
            {
              "name": "Consent checkbox",
              "value": "consent"
            }
          ]
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "type_name",
          "label": "Field name",
          "description": "Required. The key the value is sent with, for example: fullName. Letters, numbers, - and _ only",
          "value": ""
        },
        {
          "component": "multiselect",
          "valueType": "string",
          "name": "type_settings",
          "label": "Settings",
          "options": [
            {
              "name": "Required",
              "value": "required"
            },
            {
              "name": "Half width (desktop)",
              "value": "half"
            },
            {
              "name": "One third width (desktop)",
              "value": "third"
            }
          ]
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "label",
          "label": "Label",
          "description": "Required. Shown in the empty field and above it once filled in. For a consent checkbox, the consent text",
          "value": ""
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "label_placeholder",
          "label": "Placeholder (optional)",
          "description": "Example input, for example: 98765 43210. Needs a label",
          "value": ""
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "options",
          "label": "Options",
          "description": "For dropdowns, radio buttons and checkboxes: comma separated, for example: Term, Savings, ULIP. Use Label=value to send a different value",
          "value": ""
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "error",
          "label": "Error message when empty",
          "description": "For example: Please enter your full name. Leave empty for the default message",
          "value": ""
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "error_invalid",
          "label": "Error message when the format is wrong",
          "description": "For email, mobile number and pincode fields. Needs the message above",
          "value": ""
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "contact-form",
      "components": [
        "contact-form-field"
      ]
    }
  ]
}
